# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite:///./gurano.db

# Google Cloud TTS (optional)
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_LANGUAGE=ko-KR

# Whisper STT
WHISPER_MODEL=large-v3

# Analysis
ANALYSIS_INTERVAL_SEC=2.0
LIE_THRESHOLD=0.70
SUSPECT_THRESHOLD=0.50

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Captures
CAPTURE_DIR=./captures

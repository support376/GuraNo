{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://gurano-backend.railway.app/api/:path*" },
    { "source": "/ws/:path*", "destination": "https://gurano-backend.railway.app/ws/:path*" },
    { "source": "/captures/:path*", "destination": "https://gurano-backend.railway.app/captures/:path*" }
  ]
}

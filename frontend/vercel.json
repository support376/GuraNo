  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://gurano-backend.onrender.com/api/:path*" },
    { "source": "/captures/:path*", "destination": "https://gurano-backend.onrender.com/captures/:path*" }
  ]
}
